# BYOKless local browser auto relay environment
RELAY_HOST=127.0.0.1
RELAY_PORT=8765

# Shared secret between Chrome extension and this relay (>= 32 chars)
EXT_SHARED_SECRET=

# SQLite file for tasks, budgets and audit log
DB_PATH=./data/relay.db
LOG_LEVEL=info

# Optional tunnel URL for ChatGPT MCP connector (e.g., Cloudflare Tunnel / ngrok)
PUBLIC_URL=
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
LOOPBACK_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

MUTATING_BUDGET_DEFAULT=25
TOTAL_BUDGET_DEFAULT=60
BUDGET_INCREMENT=25
ACTION_DEADLINE_MS=25000
LEASE_IDLE_MS=300000
DEDUPE_WINDOW_MS=1500
APPROVAL_TTL_MS=120000
ENABLE_DEV_TOOLS=0
